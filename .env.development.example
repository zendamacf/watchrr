# Local development (npm run start:dev / db:migrate / start)
# Copy to .env in the repo root: cp .env.development.example .env
DATABASE_URL=postgresql://watchrr:watchrr@localhost:5432/watchrr
AUTH_JWT_SECRET=
THEMOVIEDB_ACCESS_TOKEN=
CRON_SECRET=
# Set to false to disable POST /api/auth/signup and the signup form
ALLOW_SIGNUP=true
RATE_LIMIT_ENABLED=true
# (0–1, default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
PORT=3000
