# Production Docker Compose (.env next to docker-compose.yml on the VPS)
DB_PASSWORD=
AUTH_JWT_SECRET=
THEMOVIEDB_ACCESS_TOKEN=
CRON_SECRET=
# Cron refresh: incremental (default) skips recently synced titles; full refreshes everything
CRON_REFRESH_MODE=incremental
# CRON_MOVIE_STALE_HOURS=168
# CRON_SHOW_STALE_HOURS=48
# CRON_SHOW_RECENT_EPISODE_DAYS=7
# CRON_SHOW_IMMINENT_EPISODE_DAYS=14
APP_PORT=3000
# Set to false to block new registrations (existing users can still sign in)
ALLOW_SIGNUP=true
# (0–1, default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Published image from a v* tag (see .github/workflows/publish-docker.yml)
APP_IMAGE=ghcr.io/zendamacf/watchrr:latest
