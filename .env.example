# Production Docker Compose (.env next to docker-compose.yml on the VPS)
DB_PASSWORD=
AUTH_JWT_SECRET=
THEMOVIEDB_ACCESS_TOKEN=
CRON_SECRET=
APP_PORT=3000
# Set to false to block new registrations (existing users can still sign in)
ALLOW_SIGNUP=true
# (0–1, default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional Umami analytics (production only; leave unset to disable)
# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# UMAMI_HOST_URL=https://your-umami.example.com
# Published image from a v* tag (see .github/workflows/publish-docker.yml)
APP_IMAGE=ghcr.io/zendamacf/watchrr:latest
