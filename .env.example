# Production Docker Compose (.env next to docker-compose.yml on the VPS)
DB_PASSWORD=
AUTH_JWT_SECRET=
THEMOVIEDB_ACCESS_TOKEN=
CRON_SECRET=
APP_PORT=3000
# Set to false to block new registrations (existing users can still sign in)
ALLOW_SIGNUP=true
# API rate limiting (in-memory per instance; set RATE_LIMIT_ENABLED=false to disable)
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_SEC=900
# RATE_LIMIT_SEARCH_MAX=60
# RATE_LIMIT_SEARCH_WINDOW_SEC=60
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_API_WINDOW_SEC=60
# RATE_LIMIT_CRON_MAX=10
# RATE_LIMIT_CRON_AUTH_MAX=120
# (0–1, default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Published image from a v* tag (see .github/workflows/publish-docker.yml)
APP_IMAGE=ghcr.io/zendamacf/watchrr:latest
